%% The full run of 24 November 2026: every usable question from the three
%% sources, sent once to Claude Sonnet 5.5 through the Claude Code CLI, with
%% the replies under trials/corpus/<case id>/claude-sonnet-5-5-corpus-1/.
%% The questions are rebuilt from the pinned sources with `bin/wasm-bytes
%% prepare' (see doc/datasets.md); they are not kept here, because some
%% WasmBench binaries are not openly licensed. A test checks the counts below
%% against the saved verdicts.
{label, <<"claude-sonnet-5-5-corpus-1">>}.
{model, <<"claude-sonnet-5-5">>}.
{recorded_on, <<"2026-11-24">>}.
{seed, 2026}.
{counts, [
    {<<"spec/read">>, [{questions, 364}, {pass, 361}, {wrong_answer, 3}]},
    {<<"spec/write">>, [{questions, 31}, {pass, 30}, {malformed_wasm, 1}]},
    {<<"wasmbench/read">>, [{questions, 192}, {pass, 183}, {malformed_answer, 8}, {too_large, 1}]},
    {<<"codecontests/write">>, [{questions, 12}, {pass, 7}, {invalid, 1}, {execution_failure, 2}, {malformed_wasm, 2}]}]}.
%% Wall-clock time, the three sources running side by side. One WasmBench
%% question, testhash, took about 30 minutes, so a second worker answered the
%% rest of that source from the end.
{minutes, [{<<"spec">>, 23}, {<<"wasmbench">>, 40}, {<<"codecontests">>, 14}]}.
%% Tokens the CLI reported, and what they cost at Claude Sonnet 5.5's list
%% prices ($2 per million input tokens, $2.50 for cache writes, $10 per
%% million output tokens). testhash alone used 399,891 output tokens, $4.02.
{tokens, [{input, 621920}, {output, 690551}]}.
{cost_usd, 8.45}.
