  "result": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"theme-color\" content=\"#0d1320\">\n<title>DX-Ball sound effect</title>\n<style>\n:root{\n  --bg:#0d1320;\n  --panel:#151d2b;\n  --panel-border:#273349;\n  --text:#e9eef6;\n  --muted:#9fb0c6;\n  --accent:#ffd166;\n  --btn:#1d2837;\n  --btn-border:#31405a;\n  --btn-active:#28405f;\n  --btn-active-border:#4d74a6;\n}\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0}\nbody{\n  min-height:100vh;\n  background:radial-gradient(1100px 520px at 50% -12%, #182234 0%, var(--bg) 62%);\n  color:var(--text);\n  font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n  padding:18px 16px 30px;\n  -webkit-text-size-adjust:100%;\n}\n.page{max-width:860px;margin:0 auto}\nh1{font-size:1.35rem;margin:0 0 6px;letter-spacing:.2px}\n.subtitle{margin:0 0 18px;color:var(--muted);font-size:.95rem;line-height:1.45}\ncode{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;background:#0a0f18;border:1px solid #22304a;border-radius:6px;padding:0 5px;font-size:.85em}\n.stage{display:flex;flex-wrap:wrap;gap:14px;align-items:center;margin:0 0 16px}\n.track-wrap{flex:1 1 300px;min-width:0}\n.track{position:relative;height:66px;border-radius:16px;background:linear-gradient(180deg,#1b2536 0%,#121a28 100%);border:1px solid var(--panel-border);box-shadow:inset 0 2px 10px rgba(0,0,0,.45)}\n.track::before{content:\"\";position:absolute;left:0;right:0;top:50%;height:2px;transform:translateY(-50%);background:repeating-linear-gradient(90deg,#2b3a55 0 2px,transparent 2px 64px);opacity:.55}\n.ball{position:absolute;top:50%;left:0;width:26px;height:26px;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle at 34% 30%, #fff8e6 0%, #ffd166 38%, #f4a261 72%, #d97706 100%);box-shadow:0 0 16px rgba(255,209,102,.55), inset 0 -3px 6px rgba(0,0,0,.25);pointer-events:none}\n.reading{flex:0 1 auto;min-width:200px;background:var(--panel);border:1px solid var(--panel-border);border-radius:14px;padding:12px 14px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:1rem;line-height:1.6;white-space:pre-line;word-break:break-word}\n.controls{display:flex;flex-wrap:wrap;gap:10px}\nbutton{flex:1 1 150px;padding:14px 16px;font-size:1rem;font-weight:600;color:var(--text);background:var(--btn);border:1px solid var(--btn-border);border-radius:12px;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent;transition:background .12s ease,border-color .12s ease,transform .05s ease}\nbutton:active{transform:translateY(1px)}\nbutton[aria-pressed=\"true\"]{background:var(--btn-active);border-color:var(--btn-active-border);box-shadow:inset 0 0 0 1px var(--btn-active-border)}\nbutton:focus-visible{outline:2px solid #7fb0ff;outline-offset:2px}\n.foot{margin:14px 0 0;color:var(--muted);font-size:.85rem;line-height:1.5}\n@media (max-width:520px){\n  .reading{flex-basis:100%;min-width:0}\n  button{flex:1 1 45%}\n}\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header>\n    <h1>DX-Ball sound effect</h1>\n    <p class=\"subtitle\">A short beep follows the ball. Its pan comes from <code>screen_pan(x)</code> in the selected WebAssembly module — Original or Reversed.</p>\n  </header>\n\n  <section class=\"stage\" aria-label=\"Ball track and reading\">\n    <div class=\"track-wrap\">\n      <div class=\"track\" id=\"track\">\n        <div class=\"ball\" id=\"ball\" aria-hidden=\"true\"></div>\n      </div>\n    </div>\n    <div id=\"reading\" class=\"reading\">loading…</div>\n  </section>\n\n  <section class=\"controls\" aria-label=\"Controls\">\n    <button id=\"sound\" type=\"button\" aria-pressed=\"false\">Sound: off</button>\n    <button id=\"mode-original\" type=\"button\" aria-pressed=\"true\">Original</button>\n    <button id=\"mode-reversed\" type=\"button\" aria-pressed=\"false\">Reversed</button>\n    <button id=\"pause\" type=\"button\" aria-pressed=\"false\">Pause</button>\n  </section>\n\n  <p class=\"foot\" id=\"note\">Same pitch, volume and length in both modes — only which module is called changes.</p>\n</main>\n<script src=\"modules.js\"></script>\n<script>\n(function () {\n  'use strict';\n\n  var MAX_X = 640;\n  var SPEED = 200; /* units per second */\n\n  var ball = document.getElementById('ball');\n  var reading = document.getElementById('reading');\n  var note = document.getElementById('note');\n  var soundBtn = document.getElementById('sound');\n  var originalBtn = document.getElementById('mode-original');\n  var reversedBtn = document.getElementById('mode-reversed');\n  var pauseBtn = document.getElementById('pause');\n\n  var modules = { original: null, reversed: null };\n  var loadNote = null;\n\n  function loadModules() {\n    var defs = window.PAN_MODULES;\n    if (!defs) {\n      loadNote = 'modules.js did not define window.PAN_MODULES';\n      return;\n    }\n    ['original', 'reversed'].forEach(function (key) {\n      var entry = defs[key];\n      if (!entry || typeof entry.bytes !== 'string') {\n        loadNote = key + ': missing base64 bytes';\n        return;\n      }\n      try {\n        var b64 = entry.bytes.replace(/\\s+/g, '');\n        var bin = atob(b64);\n        var bytes = new Uint8Array(bin.length);\n        for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n        var mod = new WebAssembly.Module(bytes);\n        var instance = new WebAssembly.Instance(mod, {});\n        var fn = instance.exports && instance.exports.screen_pan;\n        if (typeof fn !== 'function') throw new Error('missing screen_pan export');\n        modules[key] = {\n          label: (entry.label && typeof entry.label === 'string') ? entry.label : key,\n          screen_pan: fn\n        };\n      } catch (err) {\n        loadNote = key + ': ' + (err && err.message ? err.message : String(err));\n      }\n    });\n  }\n\n  loadModules();\n\n  if (loadNote) note.textContent = 'Could not load modules.js — ' + loadNote + '.';\n\n  var mode = 'original';\n  var soundOn = false;\n  var paused = false;\n  var pos = 0;\n  var x = 0;\n  var audioCtx = null;\n\n  function selectedModule() { return modules[mode] || null; }\n\n  function screenPan(xv) {\n    var mod = selectedModule();\n    if (!mod) return null;\n    var r;\n    try { r = mod.screen_pan(xv); } catch (e) { return null; }\n    if (typeof r !== 'number' || !isFinite(r)) return null;\n    return r;\n  }\n\n  function ensureAudio() {\n    if (!audioCtx) {\n      var AC = window.AudioContext || window.webkitAudioContext;\n      if (!AC) return null;\n      try { audioCtx = new AC(); } catch (e) { return null; }\n    }\n    if (audioCtx.state === 'suspended') {\n      try {\n        var p = audioCtx.resume();\n        if (p && typeof p.catch === 'function') p.catch(function () {});\n      } catch (e) {}\n    }\n    return audioCtx;\n  }\n\n  function playBeep(v) {\n    if (!audioCtx) return;\n    var ctx = audioCtx;\n    var t = ctx.currentTime;\n    var dur = 0.1;\n    var osc = ctx.createOscillator();\n    var gain = ctx.createGain();\n    var panner = ctx.createStereoPanner();\n    osc.type = 'square';\n    osc.frequency.setValueAtTime(880, t);\n    panner.pan.setValueAtTime(v / 500, t);\n    gain.gain.setValueAtTime(0.0001, t);\n    gain.gain.exponentialRampToValueAtTime(0.2, t + 0.01);\n    gain.gain.exponentialRampToValueAtTime(0.0001, t + dur - 0.01);\n    osc.connect(gain);\n    gain.connect(panner);\n    panner.connect(ctx.destination);\n    osc.start(t);\n    osc.stop(t + dur);\n    osc.onended = function () {\n      try { osc.disconnect(); gain.disconnect(); panner.disconnect(); } catch (e) {}\n    };\n  }\n\n  function renderReading() {\n    var mod = selectedModule();\n    var lines = [];\n    lines.push(mod ? mod.label : 'unavailable');\n    lines.push('x: ' + x);\n    var v = mod ? screenPan(x) : null;\n    lines.push('screen_pan: ' + (typeof v === 'number' ? String(v) : '—'));\n    reading.textContent = lines.join('\\n');\n  }\n\n  function setMode(m) {\n    mode = m;\n    originalBtn.setAttribute('aria-pressed', m === 'original' ? 'true' : 'false');\n    reversedBtn.setAttribute('aria-pressed', m === 'reversed' ? 'true' : 'false');\n    renderReading();\n  }\n\n  soundBtn.addEventListener('click', function () {\n    soundOn = !soundOn;\n    soundBtn.setAttribute('aria-pressed', soundOn ? 'true' : 'false');\n    soundBtn.textContent = soundOn ? 'Sound: on' : 'Sound: off';\n    if (soundOn) {\n      ensureAudio();\n      var v = screenPan(x);\n      if (typeof v === 'number') playBeep(v);\n    }\n  });\n\n  originalBtn.addEventListener('click', function () { setMode('original'); });\n  reversedBtn.addEventListener('click', function () { setMode('reversed'); });\n\n  pauseBtn.addEventListener('click', function () {\n    paused = !paused;\n    pauseBtn.setAttribute('aria-pressed', paused ? 'true' : 'false');\n    pauseBtn.textContent = paused ? 'Resume' : 'Pause';\n  });\n\n  setInterval(function () {\n    if (!soundOn) return;\n    var v = screenPan(x);\n    if (typeof v === 'number') playBeep(v);\n  }, 200);\n\n  var lastTs = performance.now();\n  function frame(ts) {\n    var dt = (ts - lastTs) / 1000;\n    lastTs = ts;\n    if (dt > 0.1) dt = 0.1;\n    if (dt < 0) dt = 0;\n    if (!paused) {\n      pos += SPEED * dt;\n      if (pos >= MAX_X) pos = 0;\n    }\n    x = Math.round(pos);\n    if (x < 0) x = 0;\n    if (x > MAX_X) x = MAX_X;\n    ball.style.left = (pos / MAX_X * 100) + '%';\n    renderReading();\n    requestAnimationFrame(frame);\n  }\n\n  renderReading();\n  requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>",
