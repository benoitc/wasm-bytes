  "result": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>DX-Ball beep panning demo</title>\n<style>\n:root{\n  --bg:#f7f6f2; --text:#1d1d1b; --muted:#6b6a66; --panel:#ffffff;\n  --line:#d9d6ce; --ball:#c2410c; --accent:#1d4ed8;\n}\n@media (prefers-color-scheme: dark){\n  :root{\n    --bg:#161615; --text:#ecebe6; --muted:#a3a19a; --panel:#20201e;\n    --line:#3a3935; --ball:#fb923c; --accent:#93b4ff;\n  }\n}\n*{box-sizing:border-box}\nhtml{background:var(--bg)}\nbody{\n  margin:0; background:var(--bg); color:var(--text);\n  font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n}\nmain{max-width:760px; margin:0 auto; padding:16px;}\nh1{font-size:1.6rem; line-height:1.25; margin:8px 0 12px}\np{margin:0 0 16px}\n.controls{display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin:0 0 12px}\nbutton{\n  font:inherit; color:var(--text); background:var(--panel);\n  border:1px solid var(--line); border-radius:8px;\n  padding:8px 16px; min-height:44px; cursor:pointer;\n}\nbutton:focus-visible,summary:focus-visible{outline:2px solid var(--accent); outline-offset:2px}\n.seg{display:inline-flex}\n.seg button:first-child{border-radius:8px 0 0 8px}\n.seg button:last-child{border-radius:0 8px 8px 0; margin-left:-1px}\n.seg button[aria-pressed=\"true\"]{background:var(--accent); color:var(--bg); border-color:var(--accent)}\n.hint{color:var(--muted); margin:0 0 16px; font-size:.95rem}\n.stage{\n  position:relative; height:150px; width:100%;\n  background:var(--panel); border:1px solid var(--line); border-radius:10px;\n  overflow:hidden;\n}\n.stage .lbl{position:absolute; top:6px; font-size:12px; line-height:1.3; color:var(--muted)}\n.lbl.l{left:10px}\n.lbl.m{left:50%; transform:translateX(-50%)}\n.lbl.r{right:10px}\n.ball{\n  position:absolute; top:62px; left:0; width:22px; height:22px;\n  border-radius:50%; background:var(--ball);\n}\n#reading{\n  position:absolute; top:92px; left:0; text-align:center; white-space:nowrap;\n  font:13px/1.4 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\n}\n#reading span{display:block}\n.meter{margin-top:16px}\n.bar{position:relative; height:10px; border-radius:5px; background:var(--line)}\n.marker{\n  position:absolute; top:-4px; width:4px; height:18px; border-radius:2px;\n  background:var(--accent); transform:translateX(-50%); left:50%;\n}\n.mlabels{display:flex; justify-content:space-between; gap:8px; margin-top:10px; font-size:12px; line-height:1.3; color:var(--muted)}\n.mlabels span:nth-child(2){text-align:center; flex:1}\ndetails{\n  margin-top:24px; background:var(--panel); border:1px solid var(--line);\n  border-radius:10px; padding:0 12px;\n}\nsummary{cursor:pointer; padding:12px 0; font-weight:600}\ntable{width:100%; border-collapse:collapse; table-layout:fixed; margin-bottom:12px; font-size:.9rem}\nth,td{\n  text-align:left; vertical-align:top; padding:8px 6px;\n  border-top:1px solid var(--line);\n  overflow-wrap:anywhere; word-break:break-word;\n}\nthead th{border-top:0; color:var(--muted); font-weight:600}\ntd.hash{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:.8rem}\n@media (max-width:600px){\n  table,tbody,tr,td{display:block; width:100%}\n  thead{display:none}\n  tr{border-top:1px solid var(--line); padding:6px 0}\n  td{border:0; padding:3px 0}\n  td::before{content:attr(data-label) \": \"; color:var(--muted); font-weight:600}\n}\n</style>\n</head>\n<body>\n<main>\n  <h1>A DX-Ball beep that follows the ball</h1>\n  <p>Turn the sound on, watch the ball move from left to right, and switch between Original and Reversed to hear the beep move the other way.</p>\n\n  <div class=\"controls\">\n    <button id=\"sound\" type=\"button\" aria-pressed=\"false\">Sound: off</button>\n    <div class=\"seg\" role=\"group\" aria-label=\"Module\">\n      <button id=\"mode-original\" type=\"button\" aria-pressed=\"true\">Original</button>\n      <button id=\"mode-reversed\" type=\"button\" aria-pressed=\"false\">Reversed</button>\n    </div>\n    <button id=\"pause\" type=\"button\">Pause</button>\n  </div>\n\n  <p class=\"hint\">Use headphones to hear left and right, since a phone's speakers barely separate them.</p>\n\n  <div class=\"stage\" id=\"stage\">\n    <span class=\"lbl l\">x = 0</span>\n    <span class=\"lbl m\">320</span>\n    <span class=\"lbl r\">640</span>\n    <div class=\"ball\" id=\"ball\"></div>\n    <div id=\"reading\"><span>x = 0</span><span>screen_pan(x) = …</span></div>\n  </div>\n\n  <div class=\"meter\">\n    <div class=\"bar\"><div class=\"marker\" id=\"marker\"></div></div>\n    <div class=\"mlabels\"><span>left</span><span>stereo position sent to the speakers</span><span>right</span></div>\n  </div>\n\n  <details>\n    <summary>Inspect the two files this page loaded</summary>\n    <table>\n      <thead><tr><th>Module</th><th>Model</th><th>Reply</th><th>Recorded SHA-256</th><th>Check</th></tr></thead>\n      <tbody id=\"files\"></tbody>\n    </table>\n  </details>\n</main>\n\n<script src=\"modules.js\"></script>\n<script>\n(function(){\n  \"use strict\";\n  var PERIOD = 4000;\n  var mods = window.PAN_MODULES || {};\n  var fns = {original:null, reversed:null};\n  var mode = \"original\";\n  var paused = false;\n  var phase = 0, last = null;\n  var curX = 0;\n\n  var $ = function(id){return document.getElementById(id)};\n  var stage=$(\"stage\"), ball=$(\"ball\"), reading=$(\"reading\"), marker=$(\"marker\");\n  var soundBtn=$(\"sound\"), pauseBtn=$(\"pause\");\n  var modeBtns={original:$(\"mode-original\"), reversed:$(\"mode-reversed\")};\n\n  function b64bytes(s){\n    var bin = atob(String(s||\"\").replace(/\\s+/g,\"\"));\n    var a = new Uint8Array(bin.length);\n    for(var i=0;i<bin.length;i++) a[i]=bin.charCodeAt(i);\n    return a;\n  }\n\n  function hex(buf){\n    var a=new Uint8Array(buf), s=\"\";\n    for(var i=0;i<a.length;i++) s+=(a[i]<16?\"0\":\"\")+a[i].toString(16);\n    return s;\n  }\n\n  // Files table\n  var tbody=$(\"files\");\n  var checkCells={};\n  [\"original\",\"reversed\"].forEach(function(k){\n    var m=mods[k]||{};\n    var tr=document.createElement(\"tr\");\n    function cell(label,text,cls){\n      var td=document.createElement(\"td\");\n      td.setAttribute(\"data-label\",label);\n      if(cls) td.className=cls;\n      td.textContent=text==null?\"\":String(text);\n      tr.appendChild(td);\n      return td;\n    }\n    cell(\"Module\", m.label||k);\n    cell(\"Model\", m.model);\n    cell(\"Reply\", m.reply);\n    cell(\"Recorded SHA-256\", m.sha256, \"hash\");\n    checkCells[k]=cell(\"Check\",\"checking…\");\n    tbody.appendChild(tr);\n  });\n\n  function verify(k, bytes){\n    var td=checkCells[k], m=mods[k]||{};\n    if(!bytes){ td.textContent=\"module not loaded\"; return; }\n    if(!(window.crypto && crypto.subtle && crypto.subtle.digest)){\n      td.textContent=\"not available in this browser context\"; return;\n    }\n    crypto.subtle.digest(\"SHA-256\", bytes).then(function(d){\n      var h=hex(d);\n      var ok = h===String(m.sha256||\"\").toLowerCase().trim();\n      td.textContent=(ok?\"Matches the recorded value. \":\"Does NOT match the recorded value. \")+\"Computed: \"+h;\n    }, function(){ td.textContent=\"not available in this browser context\"; });\n  }\n\n  // Load modules\n  [\"original\",\"reversed\"].forEach(function(k){\n    var m=mods[k], bytes=null;\n    try{\n      bytes=b64bytes(m && m.bytes);\n    }catch(e){ verify(k,null); return; }\n    verify(k,bytes);\n    WebAssembly.instantiate(bytes.slice(), {}).then(function(r){\n      fns[k]=r.instance.exports.screen_pan;\n      render(true);\n    }).catch(function(){\n      checkCells[k].textContent += \" (module failed to instantiate)\";\n    });\n  });\n\n  function pan(x){\n    var f=fns[mode];\n    return f ? f(x) : null;\n  }\n\n  // Rendering\n  var lastShown=null;\n  function render(force){\n    var x=curX, v=pan(x);\n    var W=stage.clientWidth;\n    var cx=16+(W-32)*x/640;\n    ball.style.left=(cx-11)+\"px\";\n    var key=x+\"|\"+v+\"|\"+mode+\"|\"+W;\n    if(!force && key===lastShown) return;\n    lastShown=key;\n    reading.children[0].textContent=\"x = \"+x;\n    reading.children[1].textContent=\"screen_pan(x) = \"+(v==null?\"…\":v);\n    var rw=reading.offsetWidth;\n    var left=Math.max(0,Math.min(W-rw, cx-rw/2));\n    reading.style.left=left+\"px\";\n    if(v!=null){\n      marker.style.left=(50+50*v/500)+\"%\";\n    }\n  }\n\n  function frame(t){\n    if(last==null) last=t;\n    if(!paused) phase=(phase+(t-last))%PERIOD;\n    last=t;\n    curX=Math.min(640, Math.floor(phase/PERIOD*641));\n    render(false);\n    requestAnimationFrame(frame);\n  }\n  requestAnimationFrame(frame);\n  window.addEventListener(\"resize\", function(){render(true)});\n\n  // Controls\n  function setMode(k){\n    mode=k;\n    for(var n in modeBtns) modeBtns[n].setAttribute(\"aria-pressed\", n===k?\"true\":\"false\");\n    render(true);\n  }\n  modeBtns.original.addEventListener(\"click\", function(){setMode(\"original\")});\n  modeBtns.reversed.addEventListener(\"click\", function(){setMode(\"reversed\")});\n\n  pauseBtn.addEventListener(\"click\", function(){\n    paused=!paused;\n    pauseBtn.textContent=paused?\"Play\":\"Pause\";\n  });\n\n  // Audio\n  var ctx=null, timer=null, soundOn=false, streamAudio=null;\n  var isIOS=/iPad|iPhone|iPod/.test(navigator.userAgent) ||\n            (navigator.platform===\"MacIntel\" && navigator.maxTouchPoints>1);\n\n  function setupAudio(){\n    if(ctx) return;\n    try{\n      if(navigator.audioSession) navigator.audioSession.type=\"playback\";\n    }catch(e){}\n    var AC=window.AudioContext||window.webkitAudioContext;\n    ctx=new AC();\n    ctx.out=ctx.destination;\n    if(isIOS && !(navigator.audioSession) && ctx.createMediaStreamDestination){\n      try{\n        var sd=ctx.createMediaStreamDestination();\n        streamAudio=document.createElement(\"audio\");\n        streamAudio.setAttribute(\"playsinline\",\"\");\n        streamAudio.srcObject=sd.stream;\n        ctx.out=sd;\n      }catch(e){ ctx.out=ctx.destination; }\n    }\n  }\n\n  function beep(){\n    if(!ctx) return;\n    var v=pan(curX);\n    if(v==null) return;\n    var t=ctx.currentTime+0.01;\n    var o=ctx.createOscillator(), g=ctx.createGain();\n    o.type=\"sine\"; o.frequency.value=880;\n    g.gain.setValueAtTime(0,t);\n    g.gain.linearRampToValueAtTime(0.3,t+0.005);\n    g.gain.setValueAtTime(0.3,t+0.07);\n    g.gain.linearRampToValueAtTime(0,t+0.08);\n    var node=g;\n    o.connect(g);\n    if(ctx.createStereoPanner){\n      var p=ctx.createStereoPanner();\n      p.pan.value=Math.max(-1,Math.min(1,v/500));\n      g.connect(p); node=p;\n    }\n    node.connect(ctx.out);\n    o.start(t); o.stop(t+0.09);\n  }\n\n  soundBtn.addEventListener(\"click\", function(){\n    soundOn=!soundOn;\n    soundBtn.textContent=soundOn?\"Sound: on\":\"Sound: off\";\n    soundBtn.setAttribute(\"aria-pressed\", soundOn?\"true\":\"false\");\n    if(soundOn){\n      setupAudio();\n      if(ctx.state!==\"running\") ctx.resume();\n      if(streamAudio){ var pr=streamAudio.play(); if(pr&&pr.catch) pr.catch(function(){}); }\n      beep();\n      timer=setInterval(beep,200);\n    }else{\n      clearInterval(timer); timer=null;\n      if(streamAudio) streamAudio.pause();\n    }\n  });\n})();\n</script>\n</body>\n</html>",
