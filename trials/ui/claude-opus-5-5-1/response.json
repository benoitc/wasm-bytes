n</style>\n</head>\n<body>\n<main>\n  <h1>DX-Ball (1996): where the ball's beep is heard</h1>\n  <p>The ball crosses the screen from left to right. Every 200&nbsp;ms a short beep is played, and its stereo position comes from the selected WebAssembly module's <code>screen_pan(x)</code>. <strong>Original</strong> puts the sound on the ball's side; <strong>Reversed</strong> puts it on the opposite side. Headphones help.</p>\n\n  <section class=\"panel\" aria-label=\"Demonstration\">\n    <div class=\"track-wrap\">\n      <div class=\"track\" aria-hidden=\"true\">\n        <span class=\"lr l\">L</span><span class=\"lr r\">R</span>\n        <div class=\"ball\" id=\"ball\"></div>\n      </div>\n      <div class=\"reading-row\">\n        <div id=\"reading\" role=\"status\" aria-live=\"off\">x = –, screen_pan(x) = –</div>\n      </div>\n    </div>\n\n    <div class=\"controls\">\n      <button id=\"sound\" type=\"button\" aria-pressed=\"false\" disabled>Sound: off</button>\n      <div class=\"group\" role=\"group\" aria-label=\"Module\">\n        <button id=\"mode-original\" type=\"button\" aria-pressed=\"true\" disabled>Original</button>\n        <button id=\"mode-reversed\" type=\"button\" aria-pressed=\"false\" disabled>Reversed</button>\n      </div>\n      <button id=\"pause\" type=\"button\" aria-pressed=\"false\" disabled>Pause</button>\n    </div>\n    <div class=\"status\" id=\"status\">Loading modules…</div>\n  </section>\n\n  <section class=\"panel\" aria-label=\"Selected module\">\n    <dl class=\"meta\">\n      <dt>Module</dt><dd id=\"meta-label\">–</dd>\n      <dt>SHA-256</dt><dd id=\"meta-sha\">–</dd>\n    </dl>\n  </section>\n</main>\n\n<script src=\"modules.js\"></script>\n<script>\n(function () {\n  \"use strict\";\n\n  var X_MAX = 640;\n  var SPEED = 160;          // x units per second\n  var BEEP_INTERVAL = 200;  // ms\n  var BEEP_FREQ = 880;      // Hz\n  var BEEP_LEN = 0.06;      // s\n  var BEEP_GAIN = 0.3;\n\n  var el = {\n    sound: document.getElementById(\"sound\"),\n    orig: document.getElementById(\"mode-original\"),\n    rev: document.getElementById(\"mode-reversed\"),\n    pause: document.getElementById(\"pause\"),\n    reading: document.getElementById(\"reading\"),\n    ball: document.getElementById(\"ball\"),\n    status: document.getElementById(\"status\"),\n    metaLabel: document.getElementById(\"meta-label\"),\n    metaSha: document.getElementById(\"meta-sha\")\n  };\n\n  var fns = { original: null, reversed: null };\n  var info = { original: null, reversed: null };\n  var mode = \"original\";\n  var x = 0;\n  var pos = 0;              // floating position\n  var paused = false;\n  var lastT = null;\n  var shownX = null, shownMode = null;\n\n  var soundOn = false;\n  var ctx = null;\n  var beepTimer = null;\n  var silentAudio = null;\n\n  function setStatus(msg, isErr) {\n    el.status.textContent = msg;\n    el.status.className = \"status\" + (isErr ? \" err\" : \"\");\n  }\n\n  function base64ToBytes(b64) {\n    var clean = String(b64).replace(/[^A-Za-z0-9+/=_-]/g, \"\").replace(/-/g, \"+\").replace(/_/g, \"/\");\n    while (clean.length % 4) clean += \"=\";\n    var bin = atob(clean);\n    var out = new Uint8Array(bin.length);\n    for (var i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);\n    return out;\n  }\n\n  // Provide harmless stubs for any imports a module might declare.\n  function buildImports(module) {\n    var imports = {};\n    var list = WebAssembly.Module.imports(module);\n    for (var i = 0; i < list.length; i++) {\n      var imp = list[i];\n      if (!imports[imp.module]) imports[imp.module] = {};\n      var v;\n      switch (imp.kind) {\n        case \"function\": v = function () { return 0; }; break;\n        case \"memory\": v = new WebAssembly.Memory({ initial: 1, maximum: 65536 }); break;\n        case \"table\": v = new WebAssembly.Table({ initial: 0, element: \"anyfunc\" }); break;\n        case \"global\":\n          try { v = new WebAssembly.Global({ value: \"i32\", mutable: false }, 0); } catch (e) { v = 0; }\n          break;\n        default: v = undefined;\n      }\n      imports[imp.module][imp.name] = v;\n    }\n    return imports;\n  }\n\n  function loadModule(key) {\n    var m = window.PAN_MODULES[key];\n    if (!m || typeof m.bytes !== \"string\") return Promise.reject(new Error(\"module '\" + key + \"' missing\"));\n    var bytes = base64ToBytes(m.bytes);\n    return WebAssembly.compile(bytes).then(function (module) {\n      return WebAssembly.instantiate(module, buildImports(module));\n    }).then(function (instance) {\n      var f = instance.exports.screen_pan;\n      if (typeof f !== \"function\") throw new Error(\"module '\" + key + \"' does not export screen_pan\");\n      fns[key] = f;\n      info[key] = m;\n    });\n  }\n\n  function pan(at) {\n    var f = fns[mode];\n    var v = f(at);\n    return Number(v);\n  }\n\n  function updateMeta() {\n    var m = info[mode];\n    el.metaLabel.textContent = m && m.label ? String(m.label) : mode;\n    el.metaSha.textContent = m && m.sha256 ? String(m.sha256) : \"–\";\n  }\n\n  function render(force) {\n    el.ball.style.setProperty(\"--x\", x);\n    el.reading.style.setProperty(\"--x\", x);\n    if (!fns[mode]) return;\n    if (force || x !== shownX || mode !== shownMode) {\n      var v;\n      try { v = pan(x); } catch (e) { v = NaN; }\n      shownX = x; shownMode = mode;\n      el.reading.textContent = \"\";\n      el.reading.appendChild(document.createTextNode(\"x = \" + x + \", screen_pan(x) = \"));\n      var s = document.createElement(\"span\");\n      s.className = \"v\";\n      s.textContent = String(v);\n      el.reading.appendChild(s);\n    }\n  }\n\n  function frame(t) {\n    if (lastT === null) lastT = t;\n    var dt = Math.min(0.1, (t - lastT) / 1000);\n    lastT = t;\n    if (!paused) {\n      pos += SPEED * dt;\n      if (pos > X_MAX) pos = pos % (X_MAX + 1);\n      x = Math.max(0, Math.min(X_MAX, Math.round(pos)));\n    }\n    render(false);\n    requestAnimationFrame(frame);\n  }\n\n  // ---------- Audio ----------\n\n  function makeSilentWavUrl() {\n    var rate = 8000, n = 4000; // 0.5 s mono 16-bit\n    var buf = new ArrayBuffer(44 + n * 2);\n    var d = new DataView(buf);\n    function str(o, s) { for (var i = 0; i < s.length; i++) d.setUint8(o + i, s.charCodeAt(i)); }\n    str(0, \"RIFF\"); d.setUint32(4, 36 + n * 2, true); str(8, \"WAVE\");\n    str(12, \"fmt \"); d.setUint32(16, 16, true); d.setUint16(20, 1, true); d.setUint16(22, 1, true);\n    d.setUint32(24, rate, true); d.setUint32(28, rate * 2, true); d.setUint16(32, 2, true); d.setUint16(34, 16, true);\n    str(36, \"data\"); d.setUint32(40, n * 2, true);\n    return URL.createObjectURL(new Blob([buf], { type: \"audio/wav\" }));\n  }\n\n  function unlockAudio() {\n    // Ask iOS to treat this page's audio as media playback (ignores the silent switch).\n    try {\n      if (navigator.audioSession && \"type\" in navigator.audioSession) navigator.audioSession.type = \"playback\";\n    } catch (e) {}\n\n    if (!ctx) {\n      var AC = window.AudioContext || window.webkitAudioContext;\n      if (!AC) { setStatus(\"Web Audio is not supported in this browser.\", true); return false; }\n      ctx = new AC();\n    }\n\n    // Fallback for older iOS: a playing <audio> element moves the session to \"playback\".\n    if (!navigator.audioSession) {\n      try {\n        if (!silentAudio) {\n          silentAudio = document.createElement(\"audio\");\n          silentAudio.setAttribute(\"playsinline\", \"\");\n          silentAudio.setAttribute(\"x-webkit-airplay\", \"deny\");\n          silentAudio.loop = true;\n          silentAudio.preload = \"auto\";\n          silentAudio.src = makeSilentWavUrl();\n        }\n        var p = silentAudio.play();\n        if (p && p.catch) p.catch(function () {});\n      } catch (e) {}\n    }\n\n    if (ctx.state !== \"running\") {\n      var r = ctx.resume();\n      if (r && r.catch) r.catch(function () {});\n    }\n    // Play one silent sample inside the gesture (needed by older Safari).\n    try {\n      var b = ctx.createBuffer(1, 1, ctx.sampleRate);\n      var s = ctx.createBufferSource();\n      s.buffer = b; s.connect(ctx.destination); s.start(0);\n    } catch (e) {}\n    return true;\n  }\n\n  function beep() {\n    if (!soundOn || !ctx || !fns[mode]) return;\n    if (ctx.state !== \"running\") { var r = ctx.resume(); if (r && r.catch) r.catch(function () {}); }\n    var v;\n    try { v = pan(x); } catch (e) { return; }\n    if (!isFinite(v)) return;\n    var t = ctx.currentTime + 0.01;\n    var osc = ctx.createOscillator();\n    var g = ctx.createGain();\n    var p = ctx.createStereoPanner ? ctx.createStereoPanner() : null;\n    osc.type = \"square\";\n    osc.frequency.setValueAtTime(BEEP_FREQ, t);\n    g.gain.setValueAtTime(0, t);\n    g.gain.linearRampToValueAtTime(BEEP_GAIN, t + 0.004);\n    g.gain.setValueAtTime(BEEP_GAIN, t + BEEP_LEN - 0.01);\n    g.gain.linearRampToValueAtTime(0, t + BEEP_LEN);\n    osc.connect(g);\n    if (p) {\n      p.pan.setValueAtTime(v / 500, t);\n      g.connect(p); p.connect(ctx.destination);\n    } else {\n      g.connect(ctx.destination);\n    }\n    osc.start(t);\n    osc.stop(t + BEEP_LEN + 0.02);\n    osc.onended = function () {\n      try { osc.disconnect(); g.disconnect(); if (p) p.disconnect(); } catch (e) {}\n    };\n  }\n\n  function setSound(on) {\n    if (on) {\n      if (!unlockAudio()) return;\n      soundOn = true;\n      if (beepTimer) clearInterval(beepTimer);\n      beep();\n      beepTimer = setInterval(beep, BEEP_INTERVAL);\n    } else {\n      soundOn = false;\n      if (beepTimer) { clearInterval(beepTimer); beepTimer = null; }\n      if (silentAudio) { try { silentAudio.pause(); } catch (e) {} }\n    }\n    el.sound.setAttribute(\"aria-pressed\", soundOn ? \"true\" : \"false\");\n    el.sound.textContent = soundOn ? \"Sound: on\" : \"Sound: off\";\n  }\n\n  function setMode(m) {\n    if (!fns[m]) return;\n    mode = m;\n    el.orig.setAttribute(\"aria-pressed\", m === \"original\" ? \"true\" : \"false\");\n    el.rev.setAttribute(\"aria-pressed\", m === \"reversed\" ? \"true\" : \"false\");\n    updateMeta();\n    render(true);\n  }\n\n  function setPaused(p) {\n    paused = p;\n    el.pause.setAttribute(\"aria-pressed\", p ? \"true\" : \"false\");\n    el.pause.textContent = p ? \"Resume\" : \"Pause\";\n  }\n\n  el.sound.addEventListener(\"click\", function () { setSound(!soundOn); });\n  el.orig.addEventListener(\"click\", function () { setMode(\"original\"); });\n  el.rev.addEventListener(\"click\", function () { setMode(\"reversed\"); });\n  el.pause.addEventListener(\"click\", function () { setPaused(!paused); });\n\n  document.addEventListener(\"visibilitychange\", function () {\n    if (!document.hidden && soundOn && ctx && ctx.state !== \"running\") {\n      var r = ctx.resume(); if (r && r.catch) r.catch(function () {});\n    }\n  });\n\n  // ---------- Start ----------\n  if (!window.PAN_MODULES) {\n    setStatus(\"modules.js was not found or did not define PAN_MODULES.\", true);\n    return;\n  }\n  if (typeof WebAssembly !== \"object\") {\n    setStatus(\"This browser does not support WebAssembly.\", true);\n    return;\n  }\n  [\"original\", \"reversed\"].forEach(function (k) {\n    var m = window.PAN_MODULES[k];\n    if (m && m.label) (k === \"original\" ? el.orig : el.rev).textContent = String(m.label);\n  });\n\n  Promise.all([loadModule(\"original\"), loadModule(\"reversed\")]).then(function () {\n    el.sound.disabled = false;\n    el.orig.disabled = false;\n    el.rev.disabled = false;\n    el.pause.disabled = false;\n    setMode(\"original\");\n    setStatus(\"Ready. Turn the sound on and switch between the two modules.\");\n    requestAnimationFrame(frame);\n  }).catch(function (e) {\n    setStatus(\"Could not load the WebAssembly modules: \" + (e && e.message ? e.message : e), true);\n  });\n})();\n</script>\n</body>\n</html>",
