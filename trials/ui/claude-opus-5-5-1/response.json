  "result": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>DX-Ball (1996) – stereo pan of the ball sound</title>\n<style>\n  :root {\n    --bg: #10131a;\n    --panel: #1a1f2b;\n    --fg: #e8ecf4;\n    --muted: #9aa4b8;\n    --accent: #ffcc33;\n    --accent2: #4fc3f7;\n    --ball: 28px;\n  }\n  * { box-sizing: border-box; }\n  html { -webkit-text-size-adjust: 100%; }\n  body {\n    margin: 0;\n    background: var(--bg);\n    color: var(--fg);\n    font: 16px/1.45 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n    overflow-x: hidden;\n  }\n  main {\n    max-width: 760px;\n    margin: 0 auto;\n    padding: 16px;\n  }\n  h1 { font-size: 1.35rem; margin: 0.2em 0 0.3em; }\n  p { margin: 0.4em 0 0.8em; color: var(--muted); }\n  .panel {\n    background: var(--panel);\n    border-radius: 12px;\n    padding: 14px;\n    margin: 14px 0;\n  }\n  .track-wrap { position: relative; padding-top: 4px; }\n  .track {\n    position: relative;\n    height: calc(var(--ball) + 16px);\n    border-radius: 999px;\n    background: linear-gradient(90deg, #233 0%, #222838 50%, #233 100%);\n    border: 1px solid #2d3547;\n    overflow: hidden;\n  }\n  .track .lr {\n    position: absolute; top: 50%; transform: translateY(-50%);\n    font-size: 0.75rem; font-weight: 700; color: #5d6780; pointer-events: none;\n  }\n  .track .l { left: 10px; }\n  .track .r { right: 10px; }\n  .ball {\n    --x: 0;\n    position: absolute;\n    top: 8px;\n    left: calc((100% - var(--ball) - 16px) * var(--x) / 640 + 8px);\n    width: var(--ball);\n    height: var(--ball);\n    border-radius: 50%;\n    background: radial-gradient(circle at 35% 30%, #fff 0%, #dfe7f5 25%, #8a95ab 100%);\n    box-shadow: 0 0 10px rgba(255,255,255,0.35);\n  }\n  .reading-row {\n    position: relative;\n    height: 2.6em;\n    margin-top: 6px;\n  }\n  #reading {\n    --x: 0;\n    position: absolute;\n    top: 0;\n    left: