  "result": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>DX-Ball sound pan</title>\n<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; }\n  body {\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n    background: #15171c;\n    color: #e8e8ee;\n    min-height: 100vh;\n    overflow-x: hidden;\n  }\n  main {\n    max-width: 680px;\n    margin: 0 auto;\n    padding: 16px;\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n  h1 { font-size: 1.3rem; margin: 8px 0 0; font-weight: 600; }\n  #track {\n    position: relative;\n    width: 100%;\n    height: 64px;\n    background: #272a33;\n    border-radius: 10px;\n    border: 1px solid #3a3e4a;\n  }\n  #ball {\n    position: absolute;\n    top: 50%;\n    width: 20px;\n    height: 20px;\n    margin-top: -10px;\n    left: 10px;\n    border-radius: 50%;\n    background: #ffcc33;\n    box-shadow: 0 0 10px rgba(255, 204, 51, 0.5);\n  }\n  #reading {\n    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n    font-size: 1.15rem;\n    margin: 0;\n    padding: 12px;\n    background: #1d2028;\n    border-radius: 8px;\n    min-height: 3em;\n    overflow-wrap: anywhere;\n  }\n  .row {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n  }\n  button {\n    flex: 1 1 140px;\n    min-height: 48px;\n    padding: 10px 14px;\n    font: inherit;\n    font-size: 1rem;\n    color: #e8e8ee;\n    background: #2e323d;\n    border: 1px solid #4a4f5e;\n    border-radius: 8px;\n    cursor: pointer;\n    -webkit-tap-highlight-color: transparent;\n    touch-action: manipulation;\n  }\n  button[aria-pressed=\"true\"] {\n    background: #3d6fd6;\n    border-color: #6b94ea;\n    color: #fff;\n  }\n  button:focus-visible { outline: 2px solid #ffcc33; outline-offset: 2px; }\n  p.note { font-size: 0.9rem; color: #9ba1b0; margin: 0; line-height: 1.4; }\n</style>\n</head>\n<body>\n<main>\n  <h1>DX-Ball pan test</h1>\n\n  <div id=\"track\" aria-hidden=\"true\"><div id=\"ball\"></div></div>\n\n  <p id=\"reading\" aria-live=\"polite\">loading…</p>\n\n  <div class=\"row\">\n    <button id=\"sound\" aria-pressed=\"false\">Sound off</button>\n    <button id=\"pause\" aria-pressed=\"false\">Pause</button>\n  </div>\n\n  <div class=\"row\">\n    <button id=\"mode-original\" aria-pressed=\"true\">Original</button>\n    <button id=\"mode-reversed\" aria-pressed=\"false\">Reversed</button>\n  </div>\n\n  <p class=\"note\">Turn the sound on and listen to where each beep sounds. Switch between Original and Reversed to compare. The numbers show the ball's x and the value returned by screen_pan for that x.</p>\n</main>\n\n<script src=\"modules.js\"></script>\n<script>\n(function () {\n  \"use strict\";\n\n  const TRACK_MAX = 640;   // x runs 0..640\n  const SPEED = 110;       // ball speed, pixels per second\n  const BEEP_MS = 200;     // beep interval\n  const BEEP_LEN = 0.09;   // beep length in seconds\n  const BEEP_FREQ = 880;   // beep pitch in Hz\n\n  const $ = (id) => document.getElementById(id);\n  const ball = $(\"ball\");\n  const reading = $(\"reading\");\n  const soundBtn = $(\"sound\");\n  const pauseBtn = $(\"pause\");\n  const origBtn = $(\"mode-original\");\n  const revBtn = $(\"mode-reversed\");\n\n  const screenPan = {};     // key -> exported screen_pan function\n  let mode = \"original\";\n  let pos = 0;              // ball position as a float; x = floor(pos)\n  let lastT = null;\n  let paused = false;\n  let soundOn = false;\n  let ctx = null;\n  let beepTimer = null;\n\n  function b64ToBytes(s) {\n    const bin = atob(s);\n    const out = new Uint8Array(bin.length);\n    for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);\n    return out;\n  }\n\n  async function loadModules() {\n    if (!window.PAN_MODULES) throw new Error(\"modules.js did not load\");\n    for (const key of [\"original\", \"reversed\"]) {\n      const def = window.PAN_MODULES[key];\n      if (!def || !def.bytes) throw new Error(\"missing module: \" + key);\n      const result = await WebAssembly.instantiate(b64ToBytes(def.bytes), {});\n      const fn = result.instance.exports.screen_pan;\n      if (typeof fn !== \"function\") throw new Error(\"screen_pan not exported by \" + key);\n      screenPan[key] = fn;\n    }\n  }\n\n  function currentX() {\n    return Math.floor(pos);\n  }\n\n  // Calls the selected module's screen_pan. Returns null if not ready.\n  function panFor(x) {\n    const fn = screenPan[mode];\n    return fn ? fn(x) : null;\n  }\n\n  function render() {\n    const x = currentX();\n    ball.style.left = \"calc(10px + (100% - 20px) * \" + (x / TRACK_MAX) + \")\";\n    const v = panFor(x);\n    if (v === null) {\n      reading.textContent = \"loading…\";\n    } else {\n      reading.textContent = \"x = \" + x + \"    screen_pan(x) = \" + v;\n    }\n  }\n\n  function frame(t) {\n    if (lastT === null) lastT = t;\n    const dt = (t - lastT) / 1000;\n    lastT = t;\n    if (!paused) {\n      pos = (pos + dt * SPEED) % (TRACK_MAX + 1);\n    }\n    render();\n    requestAnimationFrame(frame);\n  }\n\n  function beep(v) {\n    if (!ctx) return;\n    const now = ctx.currentTime;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    const panner = ctx.createStereoPanner();\n\n    osc.type = \"sine\";\n    osc.frequency.value = BEEP_FREQ;\n\n    gain.gain.setValueAtTime(0, now);\n    gain.gain.linearRampToValueAtTime(0.25, now + 0.005);\n    gain.gain.setValueAtTime(0.25, now + BEEP_LEN - 0.015);\n    gain.gain.linearRampToValueAtTime(0, now + BEEP_LEN);\n\n    panner.pan.value = v / 500;\n\n    osc.connect(gain);\n    gain.connect(panner);\n    panner.connect(ctx.destination);\n\n    osc.start(now);\n    osc.stop(now + BEEP_LEN + 0.01);\n    osc.onended = () => {\n      osc.disconnect();\n      gain.disconnect();\n      panner.disconnect();\n    };\n  }\n\n  function tick() {\n    const v = panFor(currentX());\n    if (v !== null) beep(v);\n  }\n\n  function setPressed(btn, on) {\n    btn.setAttribute(\"aria-pressed\", on ? \"true\" : \"false\");\n  }\n\n  soundBtn.addEventListener(\"click\", () => {\n    if (!soundOn) {\n      // Must be created and resumed inside a user gesture for iOS Safari.\n      if (!ctx) {\n        const AC = window.AudioContext || window.webkitAudioContext;\n        ctx = new AC();\n      }\n      // Lets audio play even when the iPhone's silent switch is on.\n      if (navigator.audioSession) {\n        try { navigator.audioSession.type = \"playback\"; } catch (e) { /* ignore */ }\n      }\n      if (ctx.state !== \"running\") ctx.resume();\n\n      soundOn = true;\n      soundBtn.textContent = \"Sound on\";\n      setPressed(soundBtn, true);\n      tick();\n      beepTimer = setInterval(tick, BEEP_MS);\n    } else {\n      soundOn = false;\n      clearInterval(beepTimer);\n      beepTimer = null;\n      soundBtn.textContent = \"Sound off\";\n      setPressed(soundBtn, false);\n    }\n  });\n\n  pauseBtn.addEventListener(\"click\", () => {\n    paused = !paused;\n    pauseBtn.textContent = paused ? \"Resume\" : \"Pause\";\n    setPressed(pauseBtn, paused);\n    render();\n  });\n\n  function selectMode(key) {\n    mode = key;\n    setPressed(origBtn, key === \"original\");\n    setPressed(revBtn, key === \"reversed\");\n    render();\n  }\n\n  origBtn.addEventListener(\"click\", () => selectMode(\"original\"));\n  revBtn.addEventListener(\"click\", () => selectMode(\"reversed\"));\n\n  loadModules()\n    .then(() => {\n      render();\n    })\n    .catch((err) => {\n      reading.textContent = \"Error: \" + err.message;\n      soundBtn.disabled = true;\n    });\n\n  requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>",
