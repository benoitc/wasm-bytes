  "result": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>DX-Ball (1996) — recovered screen_pan</title>\n<style>\n  :root {\n    color-scheme: dark;\n    --bg: #0d1020;\n    --panel: #171b30;\n    --panel-2: #1f2440;\n    --text: #eef1ff;\n    --muted: #aab1d6;\n    --accent: #ffd166;\n    --accent-2: #6ee7ff;\n    --ball: #ff5d5d;\n    --line: #3a4270;\n  }\n  * { box-sizing: border-box; }\n  html, body {\n    margin: 0;\n    padding: 0;\n    overflow-x: hidden;\n  }\n  body {\n    background: radial-gradient(1200px 700px at 50% -10%, #232a52 0%, var(--bg) 60%);\n    color: var(--text);\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    min-height: 100vh;\n    -webkit-text-size-adjust: 100%;\n  }\n  .app {\n    max-width: 880px;\n    margin: 0 auto;\n    padding: 18px 16px 28px;\n  }\n  header h1 {\n    font-size: clamp(1.15rem, 4.6vw, 1.6rem);\n    line-height: 1.25;\n    margin: 6px 0 8px;\n    letter-spacing: 0.02em;\n  }\n  .sub {\n    margin: 0 0 14px;\n    color: var(--muted);\n    font-size: 0.95rem;\n    line-height: 1.45;\n  }\n  code {\n    background: var(--panel-2);\n    padding: 0.1em 0.35em;\n    border-radius: 6px;\n    font-size: 0.9em;\n  }\n  .controls {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    margin: 0 0 16px;\n  }\n  button {\n    appearance: none;\n    border: 1px solid var(--line);\n    background: var(--panel-2);\n    color: var(--text);\n    border-radius: 12px;\n    padding: 12px 16px;\n    font-size: 1rem;\n    font-weight: 650;\n    cursor: pointer;\n    min-height: 48px;\n    touch-action: manipulation;\n    transition: transform 0.06s ease, background 0.15s ease, border-color 0.15s ease;\n  }\n  button:hover { background: #262c4e; }\n  button:active { transform: translateY(1px); }\n  button[aria-pressed=\"true\"] {\n    background: #2c3560;\n    border-color: var(--accent);\n    box-shadow: inset 0 0 0 1px var(--accent);\n  }\n  #sound[aria-pressed=\"true\"] { border-color: var(--accent-2); box-shadow: inset 0 0 0 1px var(--accent-2); }\n  .stage {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 14px;\n    background: var(--panel);\n    border: 1px solid var(--line);\n    border-radius: 16px;\n    padding: 14px;\n  }\n  .track {\n    position: relative;\n    flex: 1 1 240px;\n    min-width: 0;\n    height: 64px;\n    border-radius: 14px;\n    background: linear-gradient(180deg, #11142a 0%, #0a0d1d 100%);\n    border: 1px solid var(--line);\n    overflow: hidden;\n  }\n  .lane {\n    position: absolute;\n    left: 0;\n    right: 0;\n    top: 50%;\n    height: 2px;\n    transform: translateY(-50%);\n    background: repeating-linear-gradient(90deg, var(--line) 0 12px, transparent 12px 24px);\n    opacity: 0.8;\n  }\n  .tick {\n    position: absolute;\n    top: 8px;\n    bottom: 8px;\n    width: 1px;\n    background: var(--line);\n    opacity: 0.55;\n  }\n  .ball {\n    position: absolute;\n    top: 50%;\n    left: 14px;\n    width: 28px;\n    height: 28px;\n    margin: -14px 0 0 0;\n    border-radius: 50%;\n    background: radial-gradient(circle at 35% 30%, #ffd9d9 0%, var(--ball) 45%, #7a1f1f 100%);\n    box-shadow: 0 0 14px rgba(255, 93, 93, 0.55);\n    transform: translateX(-50%);\n    will-change: left;\n  }\n  .reading {\n    flex: 0 1 auto;\n    min-width: 190px;\n    max-width: 100%;\n    background: var(--panel-2);\n    border: 1px solid var(--line);\n    border-radius: 12px;\n    padding: 10px 12px;\n    font-variant-numeric: tabular-nums;\n    font-size: 0.98rem;\n    line-height: 1.5;\n    white-space: pre-wrap;\n    overflow-wrap: anywhere;\n  }\n  .reading .mode { color: var(--accent); font-weight: 700; }\n  .reading .val { color: var(--accent-2); font-weight: 700; }\n  .hint {\n    margin: 12px 0 0;\n    color: var(--muted);\n    font-size: 0.85rem;\n    line-height: 1.5;\n  }\n  footer {\n    margin-top: 14px;\n    color: var(--muted);\n    font-size: 0.8rem;\n    line-height: 1.5;\n  }\n  @media (max-width: 560px) {\n    .stage { flex-direction: column; align-items: stretch; }\n    .reading { min-width: 0; }\n    .controls button { flex: 1 1 45%; }\n  }\n</style>\n</head>\n<body>\n<main class=\"app\">\n  <header>\n    <h1>DX-Ball (1996) — recovered screen_pan</h1>\n    <p class=\"sub\">A ball crosses the track. While sound is on, a short beep plays every 200&nbsp;ms, panned by the selected module&rsquo;s <code>screen_pan(x)</code>. Same beep in both modes; only the module changes.</p>\n  </header>\n\n  <section class=\"controls\" aria-label=\"Controls\">\n    <button id=\"sound\" type=\"button\" aria-pressed=\"false\">Sound: off</button>\n    <button id=\"mode-original\" type=\"button\" aria-pressed=\"true\">Original</button>\n    <button id=\"mode-reversed\" type=\"button\" aria-pressed=\"false\">Reversed</button>\n    <button id=\"pause\" type=\"button\" aria-pressed=\"false\">Pause</button>\n  </section>\n\n  <section class=\"stage\" aria-label=\"Ball and reading\">\n    <div class=\"track\" id=\"track\" aria-hidden=\"true\">\n      <div class=\"lane\"></div>\n      <div class=\"tick\" style=\"left:0%\"></div>\n      <div class=\"tick\" style=\"left:25%\"></div>\n      <div class=\"tick\" style=\"left:50%\"></div>\n      <div class=\"tick\" style=\"left:75%\"></div>\n      <div class=\"tick\" style=\"left:100%\"></div>\n      <div class=\"ball\" id=\"ball\"></div>\n    </div>\n    <div class=\"reading\" id=\"reading\" aria-live=\"polite\">loading modules…</div>\n  </section>\n\n  <p class=\"hint\">Sound on: tap <strong>Sound</strong> once. Tap again to stop. Switch <strong>Original</strong> / <strong>Reversed</strong> to hear the opposite pan. <strong>Pause</strong> freezes the ball; the reading still updates from the selected module.</p>\n\n  <footer>Ball position x is an integer from 0 (left edge) through 640 (right edge). Every value shown or played comes from calling <code>screen_pan</code> on the selected module — nothing is computed here.</footer>\n</main>\n\n<script src=\"modules.js\"></script>\n<script>\n(function () {\n  'use strict';\n\n  var TRAVEL_MS = 6000;   /* one full left-to-right pass */\n  var X_MAX = 640;\n  var BEEP_MS = 200;\n  var BEEP_LENGTH = 0.09;\n  var BEEP_FREQ = 660;\n  var BEEP_VOLUME = 0.22;\n  var BALL_SIZE = 28;\n\n  var els = {\n    sound: document.getElementById('sound'),\n    modeOriginal: document.getElementById('mode-original'),\n    modeReversed: document.getElementById('mode-reversed'),\n    pause: document.getElementById('pause'),\n    reading: document.getElementById('reading'),\n    track: document.getElementById('track'),\n    ball: document.getElementById('ball')\n  };\n\n  var state = {\n    x: 0,\n    elapsed: 0,\n    last: null,\n    paused: false,\n    soundOn: false,\n    selected: 'original',\n    ready: false\n  };\n\n  var modules = { original: null, reversed: null };\n  var labels = { original: 'Original', reversed: 'Reversed' };\n  var audioCtx = null;\n  var beepTimer = null;\n  var active = [];\n\n  function base64ToBytes(b64) {\n    var clean = String(b64 || '').replace(/\\s+/g, '');\n    var bin = atob(clean);\n    var bytes = new Uint8Array(bin.length);\n    for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n    return bytes;\n  }\n\n  function loadModule(spec, name) {\n    if (!spec || typeof spec.bytes !== 'string') {\n      return Promise.reject(new Error(name + ': missing bytes'));\n    }\n    var bytes = base64ToBytes(spec.bytes);\n    return WebAssembly.instantiate(bytes, {}).then(function (result) {\n      var fn = result.instance.exports.screen_pan;\n      if (typeof fn !== 'function') {\n        throw new Error(name + ': module does not export screen_pan');\n      }\n      return fn;\n    });\n  }\n\n  function init() {\n    var specs = window.PAN_MODULES;\n    if (!specs) {\n      setReading('modules.js not found');\n      return;\n    }\n    labels.original = (specs.original && specs.original.label) || 'Original';\n    labels.reversed = (specs.reversed && specs.reversed.label) || 'Reversed';\n    Promise.all([\n      loadModule(specs.original, 'original'),\n      loadModule(specs.reversed, 'reversed')\n    ]).then(function (fns) {\n      modules.original = fns[0];\n      modules.reversed = fns[1];\n      state.ready = true;\n      updateReading();\n    }).catch(function (err) {\n      setReading('failed to load modules: ' + (err && err.message ? err.message : err));\n    });\n  }\n\n  function selectedFn() {\n    return modules[state.selected] || null;\n  }\n\n  function currentLabel() {\n    return labels[state.selected] || state.selected;\n  }\n\n  function setReading(text) {\n    els.reading.textContent = text;\n  }\n\n  function updateReading() {\n    var fn = selectedFn();\n    if (!fn) {\n      setReading('loading modules…');\n      return;\n    }\n    var v;\n    try {\n      v = fn(state.x);\n    } catch (err) {\n      setReading(currentLabel() + ' · x = ' + state.x + ' · screen_pan(x) = error');\n      return;\n    }\n    els.reading.innerHTML = '';\n    var mode = document.createElement('span');\n    mode.className = 'mode';\n    mode.textContent = currentLabel() + '  ';\n    var rest = document.createTextNode('x = ' + state.x + '  ·  screen_pan(x) = ');\n    var val = document.createElement('span');\n    val.className = 'val';\n    val.textContent = String(v);\n    els.reading.appendChild(mode);\n    els.reading.appendChild(rest);\n    els.reading.appendChild(val);\n  }\n\n  function render() {\n    var pct = state.x / X_MAX;\n    els.ball.style.left = 'calc(' + (BALL_SIZE / 2) + 'px + (100% - ' + BALL_SIZE + 'px) * ' + pct + ')';\n  }\n\n  function frame(now) {\n    if (state.last === null) state.last = now;\n    var dt = now - state.last;\n    state.last = now;\n    if (!state.paused) {\n      state.elapsed += dt;\n      var t = (state.elapsed % TRAVEL_MS) / TRAVEL_MS;\n      state.x = Math.min(X_MAX, Math.floor(t * (X_MAX + 1)));\n    }\n    render();\n    updateReading();\n    requestAnimationFrame(frame);\n  }\n\n  function stopActiveBeeps() {\n    for (var i = 0; i < active.length; i++) {\n      try { active[i].stop(); } catch (e) {}\n    }\n    active = [];\n  }\n\n  function playBeep() {\n    if (!state.soundOn) return;\n    if (!audioCtx) return;\n    var fn = selectedFn();\n    if (!fn) return;\n    var v;\n    try {\n      v = fn(state.x);\n    } catch (err) {\n      return;\n    }\n    var pan = v / 500;\n    var t = audioCtx.currentTime;\n    var osc = audioCtx.createOscillator();\n    var gain = audioCtx.createGain();\n    var panner = audioCtx.createStereoPanner();\n    osc.type = 'square';\n    osc.frequency.setValueAtTime(BEEP_FREQ, t);\n    gain.gain.setValueAtTime(0.0001, t);\n    gain.gain.exponentialRampToValueAtTime(BEEP_VOLUME, t + 0.005);\n    gain.gain.exponentialRampToValueAtTime(0.0001, t + BEEP_LENGTH);\n    panner.pan.setValueAtTime(pan, t);\n    osc.connect(gain);\n    gain.connect(panner);\n    panner.connect(audioCtx.destination);\n    osc.start(t);\n    osc.stop(t + BEEP_LENGTH + 0.02);\n    active.push(osc);\n    osc.onended = function () {\n      var idx = active.indexOf(osc);\n      if (idx >= 0) active.splice(idx, 1);\n    };\n  }\n\n  function startSound() {\n    if (navigator.audioSession) {\n      try { navigator.audioSession.type = 'playback'; } catch (e) {}\n    }\n    var Ctx = window.AudioContext || window.webkitAudioContext;\n    if (!audioCtx && Ctx) {\n      try { audioCtx = new Ctx(); } catch (e) { audioCtx = null; }\n    }\n    if (audioCtx && audioCtx.state === 'suspended') {\n      try {\n        var p = audioCtx.resume();\n        if (p && typeof p.catch === 'function') p.catch(function () {});\n      } catch (e) {}\n    }\n    state.soundOn = true;\n    els.sound.textContent = 'Sound: on';\n    els.sound.setAttribute('aria-pressed', 'true');\n    playBeep();\n    beepTimer = setInterval(playBeep, BEEP_MS);\n  }\n\n  function stopSound() {\n    state.soundOn = false;\n    if (beepTimer) { clearInterval(beepTimer); beepTimer = null; }\n    stopActiveBeeps();\n    els.sound.textContent = 'Sound: off';\n    els.sound.setAttribute('aria-pressed', 'false');\n  }\n\n  function selectMode(mode) {\n    state.selected = mode;\n    var orig = mode === 'original';\n    els.modeOriginal.setAttribute('aria-pressed', String(orig));\n    els.modeReversed.setAttribute('aria-pressed', String(!orig));\n    updateReading();\n  }\n\n  els.sound.addEventListener('click', function () {\n    if (state.soundOn) {\n      stopSound();\n    } else {\n      startSound();\n    }\n  });\n\n  els.modeOriginal.addEventListener('click', function () { selectMode('original'); });\n  els.modeReversed.addEventListener('click', function () { selectMode('reversed'); });\n\n  els.pause.addEventListener('click', function () {\n    state.paused = !state.paused;\n    els.pause.textContent = state.paused ? 'Resume' : 'Pause';\n    els.pause.setAttribute('aria-pressed', String(state.paused));\n  });\n\n  init();\n  selectMode('original');\n  requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>",
