  "result": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>DX-Ball: where the beep goes</title>\n<style>\n  :root {\n    --bg: #f7f6f2;\n    --text: #1d1d1b;\n    --muted: #6b6a66;\n    --panel: #ffffff;\n    --line: #d9d6ce;\n    --ball: #c2410c;\n    --accent: #1d4ed8;\n  }\n  @media (prefers-color-scheme: dark) {\n    :root {\n      --bg: #161615;\n      --text: #ecebe6;\n      --muted: #a3a19a;\n      --panel: #20201e;\n      --line: #3a3935;\n      --ball: #fb923c;\n      --accent: #93b4ff;\n    }\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; }\n  body {\n    background: var(--bg);\n    color: var(--text);\n    font: 16px/1.5 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n    -webkit-text-size-adjust: 100%;\n  }\n  .wrap {\n    max-width: 760px;\n    margin: 0 auto;\n    padding: 24px 16px 40px;\n  }\n  h1 {\n    font-size: 1.5rem;\n    line-height: 1.3;\n    margin: 0 0 12px;\n  }\n  p { margin: 0 0 14px; }\n  .muted { color: var(--muted); }\n  .small { font-size: 13px; line-height: 1.4; }\n\n  .controls {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 8px;\n    margin: 0 0 10px;\n  }\n  .btn, .seg button {\n    font: inherit;\n    color: var(--text);\n    background: var(--panel);\n    border: 1px solid var(--line);\n    border-radius: 8px;\n    padding: 8px 14px;\n    cursor: pointer;\n    -webkit-tap-highlight-color: transparent;\n  }\n  .btn:focus-visible, .seg button:focus-visible {\n    outline: 2px solid var(--accent);\n    outline-offset: 2px;\n  }\n  .seg {\n    display: inline-flex;\n    border: 1px solid var(--line);\n    border-radius: 8px;\n    overflow: hidden;\n    background: var(--panel);\n  }\n  .seg button {\n    border: 0;\n    border-radius: 0;\n  }\n  .seg button + button { border-left: 1px solid var(--line); }\n  .seg button[aria-pressed=\"true\"] {\n    background: var(--accent);\n    color: var(--bg);\n  }\n\n  .stage {\n    position: relative;\n    width: 100%;\n    height: 150px;\n    background: var(--panel);\n    border: 1px solid var(--line);\n    border-radius: 10px;\n    overflow: hidden;\n    margin-top: 14px;\n  }\n  .lab {\n    position: absolute;\n    top: 10px;\n    font-size: 12px;\n    color: var(--muted);\n    white-space: nowrap;\n  }\n  .lab.l { left: 10px; }\n  .lab.c { left: 50%; transform: translateX(-50%); }\n  .lab.r { right: 10px; }\n  .ball {\n    position: absolute;\n    top: 62px;\n    left: 0;\n    width: 22px;\n    height: 22px;\n    border-radius: 50%;\n    background: var(--ball);\n  }\n  .reading {\n    position: absolute;\n    top: 90px;\n    left: 0;\n    transform: translateX(-50%);\n    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n    font-size: 13px;\n    line-height: 1.4;\n    text-align: center;\n    white-space: pre-line;\n    pointer-events: none;\n  }\n\n  .meter { margin-top: 14px; }\n  .bar {\n    position: relative;\n    height: 10px;\n    border-radius: 999px;\n    background: var(--line);\n  }\n  .marker {\n    position: absolute;\n    top: -4px;\n    left: 50%;\n    width: 4px;\n    height: 18px;\n    border-radius: 2px;\n    background: var(--accent);\n    transform: translateX(-50%);\n  }\n  .meter-labels {\n    display: flex;\n    gap: 8px;\n    margin-top: 8px;\n    font-size: 12px;\n    color: var(--muted);\n  }\n  .meter-labels span:nth-child(2) {\n    flex: 1;\n    text-align: center;\n  }\n  .meter-labels span:last-child { text-align: right; }\n\n  .inspect {\n    margin-top: 24px;\n    background: var(--panel);\n    border: 1px solid var(--line);\n    border-radius: 10px;\n    padding: 10px 14px;\n  }\n  .inspect summary {\n    cursor: pointer;\n    font-weight: 600;\n    padding: 4px 0;\n  }\n  table {\n    width: 100%;\n    border-collapse: collapse;\n    table-layout: fixed;\n    font-size: 13px;\n    margin-top: 8px;\n  }\n  th, td {\n    text-align: left;\n    vertical-align: top;\n    padding: 8px 6px;\n    border-top: 1px solid var(--line);\n    overflow-wrap: anywhere;\n    word-break: break-word;\n  }\n  th {\n    color: var(--muted);\n    font-weight: 600;\n  }\n  .hash {\n    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n    font-size: 12px;\n    overflow-wrap: anywhere;\n    word-break: break-all;\n  }\n  .model { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }\n</style>\n</head>\n<body>\n<main class=\"wrap\">\n  <h1>DX-Ball: where the beep goes</h1>\n  <p>Turn the sound on and watch the ball move from left to right. Switch between Original and Reversed to hear the beep move the other way.</p>\n\n  <div class=\"controls\">\n    <button id=\"sound\" class=\"btn\" type=\"button\">Sound: off</button>\n    <div class=\"seg\" role=\"group\" aria-label=\"Module\">\n      <button id=\"mode-original\" type=\"button\" aria-pressed=\"true\">Original</button>\n      <button id=\"mode-reversed\" type=\"button\" aria-pressed=\"false\">Reversed</button>\n    </div>\n    <button id=\"pause\" class=\"btn\" type=\"button\">Pause</button>\n  </div>\n  <p class=\"muted small\">Use headphones to hear left and right, since a phone's speakers barely separate them.</p>\n\n  <div id=\"stage\" class=\"stage\">\n    <span class=\"lab l\">x = 0</span>\n    <span class=\"lab c\">320</span>\n    <span class=\"lab r\">640</span>\n    <div id=\"ball\" class=\"ball\"></div>\n    <div id=\"reading\" class=\"reading\"></div>\n  </div>\n\n  <div class=\"meter\">\n    <div class=\"bar\"><div id=\"marker\" class=\"marker\"></div></div>\n    <div class=\"meter-labels\">\n      <span>left</span>\n      <span>stereo position sent to the speakers</span>\n      <span>right</span>\n    </div>\n  </div>\n\n  <details class=\"inspect\">\n    <summary>Inspect the two files this page loaded</summary>\n    <table>\n      <thead>\n        <tr>\n          <th style=\"width:18%\">Module</th>\n          <th style=\"width:30%\">Model and reply</th>\n          <th style=\"width:26%\">SHA-256 recorded</th>\n          <th style=\"width:26%\">SHA-256 of loaded bytes</th>\n        </tr>\n      </thead>\n      <tbody id=\"rows\"></tbody>\n    </table>\n  </details>\n</main>\n\n<script src=\"modules.js\"></script>\n<script>\n(function () {\n  'use strict';\n\n  const $ = (id) => document.getElementById(id);\n  const soundBtn = $('sound');\n  const origBtn = $('mode-original');\n  const revBtn = $('mode-reversed');\n  const pauseBtn = $('pause');\n  const reading = $('reading');\n  const ball = $('ball');\n  const stage = $('stage');\n  const marker = $('marker');\n  const rowsEl = $('rows');\n\n  const SPEED = 120;      // stage pixels per second\n  const BEEP_EVERY = 200; // ms\n\n  const mods = {};        // key -> { bytes, fn }\n  let ready = false;\n  let mode = 'original';\n  let pos = 0;            // float position, 0..640\n  let x = 0;              // integer position, 0..640\n  let v = 0;              // last value returned by screen_pan\n  let paused = false;\n  let last = performance.now();\n\n  let ac = null;\n  let soundOn = false;\n  let timer = null;\n\n  function pan(xVal) {\n    return Number(mods[mode].fn(xVal));\n  }\n\n  function setMode(m) {\n    mode = m;\n    origBtn.setAttribute('aria-pressed', String(m === 'original'));\n    revBtn.setAttribute('aria-pressed', String(m === 'reversed'));\n    if (ready) v = pan(x);\n  }\n  origBtn.addEventListener('click', () => setMode('original'));\n  revBtn.addEventListener('click', () => setMode('reversed'));\n\n  pauseBtn.addEventListener('click', () => {\n    paused = !paused;\n    pauseBtn.textContent = paused ? 'Play' : 'Pause';\n  });\n\n  soundBtn.addEventListener('click', () => {\n    if (!soundOn) {\n      if (!ac) {\n        const Ctx = window.AudioContext || window.webkitAudioContext;\n        if (!Ctx) {\n          reading.textContent = 'Web Audio is not available in this browser.';\n          return;\n        }\n        ac = new Ctx();\n      }\n      // Let playback sound even when the iPhone silent switch is on (Safari 16.4+).\n      try {\n        if (navigator.audioSession) navigator.audioSession.type = 'playback';\n      } catch (e) { /* ignore */ }\n      if (ac.state !== 'running') ac.resume();\n      soundOn = true;\n      soundBtn.textContent = 'Sound: on';\n      beep();\n      timer = setInterval(beep, BEEP_EVERY);\n    } else {\n      soundOn = false;\n      clearInterval(timer);\n      timer = null;\n      soundBtn.textContent = 'Sound: off';\n    }\n  });\n\n  function beep() {\n    if (!ac || !ready) return;\n    const t = ac.currentTime;\n    const osc = ac.createOscillator();\n    const gain = ac.createGain();\n    const panner = ac.createStereoPanner();\n    osc.type = 'sine';\n    osc.frequency.value = 880;\n    gain.gain.setValueAtTime(0, t);\n    gain.gain.linearRampToValueAtTime(0.25, t + 0.005);\n    gain.gain.setValueAtTime(0.25, t + 0.055);\n    gain.gain.linearRampToValueAtTime(0, t + 0.07);\n    panner.pan.value = pan(x) / 500;\n    osc.connect(gain);\n    gain.connect(panner);\n    panner.connect(ac.destination);\n    osc.start(t);\n    osc.stop(t + 0.08);\n  }\n\n  function render() {\n    const W = stage.clientWidth;\n    const center = 16 + (x / 640) * (W - 32);\n    ball.style.left = (center - 11) + 'px';\n\n    reading.textContent = 'x = ' + x + '\\nscreen_pan(x) = ' + v;\n    const half = reading.offsetWidth / 2;\n    const clamped = Math.min(Math.max(center, half + 4), W - half - 4);\n    reading.style.left = clamped + 'px';\n\n    marker.style.left = (50 + v / 10) + '%';\n  }\n\n  function frame(now) {\n    const dt = Math.min(0.1, (now - last) / 1000);\n    last = now;\n    if (!paused) pos = (pos + dt * SPEED) % 640;\n    x = Math.round(pos);\n    if (ready) v = pan(x);\n    render();\n    requestAnimationFrame(frame);\n  }\n\n  async function loadModule(key) {\n    const info = window.PAN_MODULES[key];\n    const bin = atob(info.bytes);\n    const bytes = new Uint8Array(bin.length);\n    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n    const result = await WebAssembly.instantiate(bytes, {});\n    const fn = result.instance.exports.screen_pan;\n    if (typeof fn !== 'function') throw new Error(key + ' does not export screen_pan');\n    return { bytes, fn };\n  }\n\n  function hex(buf) {\n    return Array.from(new Uint8Array(buf), (b) => b.toString(16).padStart(2, '0')).join('');\n  }\n\n  function buildRows() {\n    const cells = {};\n    for (const key of ['original', 'reversed']) {\n      const info = window.PAN_MODULES[key];\n      const tr = document.createElement('tr');\n\n      const tdLabel = document.createElement('td');\n      tdLabel.textContent = info.label;\n\n      const tdModel = document.createElement('td');\n      const model = document.createElement('div');\n      model.className = 'model';\n      model.textContent = info.model;\n      const reply = document.createElement('div');\n      reply.className = 'muted small';\n      reply.textContent = info.reply;\n      tdModel.append(model, reply);\n\n      const tdRecorded = document.createElement('td');\n      const rec = document.createElement('div');\n      rec.className = 'hash';\n      rec.textContent = info.sha256;\n      tdRecorded.appendChild(rec);\n\n      const tdLoaded = document.createElement('td');\n      tdLoaded.textContent = 'Computing...';\n      cells[key] = tdLoaded;\n\n      tr.append(tdLabel, tdModel, tdRecorded, tdLoaded);\n      rowsEl.appendChild(tr);\n    }\n    return cells;\n  }\n\n  async function fillHashCell(key, cell) {\n    const recorded = String(window.PAN_MODULES[key].sha256 || '').trim().toLowerCase();\n    const m = mods[key];\n    if (!m) {\n      cell.textContent = 'Not loaded.';\n      return;\n    }\n    if (!(window.crypto && window.crypto.subtle)) {\n      cell.textContent = 'Not computed: SHA-256 is not available in this browser context.';\n      return;\n    }\n    try {\n      const h = hex(await window.crypto.subtle.digest('SHA-256', m.bytes));\n      const ok = h === recorded;\n      cell.textContent = '';\n      const code = document.createElement('div');\n      code.className = 'hash';\n      code.textContent = h;\n      const note = document.createElement('div');\n      note.className = 'muted small';\n      note.textContent = ok\n        ? 'Matches the recorded SHA-256.'\n        : 'Does not match the recorded SHA-256.';\n      cell.append(code, note);\n    } catch (e) {\n      cell.textContent = 'Not computed: ' + e.message;\n    }\n  }\n\n  async function init() {\n    if (!window.PAN_MODULES) {\n      reading.textContent = 'modules.js did not load.';\n      requestAnimationFrame(frame);\n      return;\n    }\n    const cells = buildRows();\n    try {\n      for (const key of ['original', 'reversed']) {\n        mods[key] = await loadModule(key);\n      }\n    } catch (e) {\n      reading.textContent = 'Could not load the modules: ' + e.message;\n      requestAnimationFrame(frame);\n      return;\n    }\n    ready = true;\n    v = pan(x);\n    setMode(mode);\n    for (const key of ['original', 'reversed']) {\n      fillHashCell(key, cells[key]);\n    }\n    requestAnimationFrame(frame);\n  }\n\n  window.addEventListener('resize', render);\n  init();\n})();\n</script>\n</body>\n</html>",
