  "result": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>DX-Ball (1996) sound effect</title>\n<style>\n  :root{\n    --bg:#f7f6f2;\n    --text:#1d1d1b;\n    --muted:#6b6a66;\n    --panel:#ffffff;\n    --line:#d9d6ce;\n    --ball:#c2410c;\n    --accent:#1d4ed8;\n  }\n  @media (prefers-color-scheme: dark){\n    :root{\n      --bg:#161615;\n      --text:#ecebe6;\n      --muted:#a3a19a;\n      --panel:#20201e;\n      --line:#3a3935;\n      --ball:#fb923c;\n      --accent:#93b4ff;\n    }\n  }\n  *{ box-sizing:border-box; }\n  html,body{ margin:0; padding:0; }\n  body{\n    background:var(--bg);\n    color:var(--text);\n    font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n    font-size:16px;\n    line-height:1.5;\n  }\n  .wrap{\n    max-width:760px;\n    margin:0 auto;\n    padding:28px 16px 44px;\n  }\n  h1{\n    font-size:1.55rem;\n    line-height:1.3;\n    letter-spacing:-0.01em;\n    margin:0 0 10px;\n  }\n  .lede{ margin:0 0 20px; }\n  .controls{\n    display:flex;\n    flex-wrap:wrap;\n    gap:10px;\n    align-items:center;\n    margin:0 0 10px;\n  }\n  button{\n    font:inherit;\n    color:var(--text);\n    background:var(--panel);\n    border:1px solid var(--line);\n    border-radius:8px;\n    padding:9px 16px;\n    min-height:40px;\n    cursor:pointer;\n  }\n  button:hover{ border-color:var(--accent); }\n  button:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }\n  .segmented{ display:inline-flex; }\n  .segmented button{ border-radius:0; margin-left:-1px; }\n  .segmented button:first-child{ border-radius:8px 0 0 8px; margin-left:0; }\n  .segmented button:last-child{ border-radius:0 8px 8px 0; }\n  .segmented button.selected{\n    background:var(--accent);\n    color:var(--bg);\n    border-color:var(--accent);\n    position:relative;\n    z-index:1;\n  }\n  .hint{ color:var(--muted); font-size:14px; margin:0 0 14px; }\n  .stage{\n    position:relative;\n    height:150px;\n    background:var(--panel);\n    border:1px solid var(--line);\n    border-radius:10px;\n    overflow:hidden;\n  }\n  .ticks{\n    position:absolute; top:0; left:0; right:0;\n    display:flex; justify-content:space-between;\n    padding:8px 12px;\n    color:var(--muted);\n    font-size:12px;\n    font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\n    pointer-events:none;\n  }\n  .ball{\n    position:absolute;\n    width:22px; height:22px;\n    border-radius:50%;\n    background:var(--ball);\n    top:62px; left:16px;\n    transform:translate(-50%,-50%);\n  }\n  .reading{\n    position:absolute;\n    top:84px; left:50%;\n    width:190px;\n    transform:translateX(-50%);\n    text-align:center;\n    font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\n    font-size:14px;\n    line-height:1.5;\n    white-space:pre;\n    pointer-events:none;\n  }\n  .meter{\n    position:relative;\n    height:18px;\n    margin-top:16px;\n  }\n  .meter .bar{\n    position:absolute; left:0; right:0; top:4px;\n    height:10px;\n    border-radius:999px;\n    background:var(--line);\n  }\n  .meter .marker{\n    position:absolute; top:0; left:50%;\n    width:4px; height:18px;\n    border-radius:2px;\n    background:var(--accent);\n    transform:translateX(-50%);\n  }\n  .meter-labels{\n    display:grid;\n    grid-template-columns:1fr auto 1fr;\n    gap:8px;\n    color:var(--muted);\n    font-size:12px;\n    margin-top:8px;\n  }\n  .meter-labels span:nth-child(1){ text-align:left; }\n  .meter-labels span:nth-child(2){ text-align:center; }\n  .meter-labels span:nth-child(3){ text-align:right; }\n  .inspect{\n    margin-top:24px;\n    border:1px solid var(--line);\n    border-radius:10px;\n    background:var(--panel);\n  }\n  .inspect summary{\n    cursor:pointer;\n    padding:12px 14px;\n    font-weight:600;\n    user-select:none;\n  }\n  .inspect-body{ padding:0 14px 14px; }\n  table{\n    width:100%;\n    border-collapse:collapse;\n    table-layout:fixed;\n    font-size:13px;\n  }\n  th,td{\n    text-align:left;\n    vertical-align:top;\n    padding:8px 8px 8px 0;\n    border-top:1px solid var(--line);\n    overflow-wrap:anywhere;\n    word-break:break-word;\n  }\n  th{\n    color:var(--muted);\n    font-weight:600;\n    font-size:12px;\n    border-top:none;\n  }\n  td code{\n    font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\n    font-size:12px;\n  }\n  .sub{\n    display:block;\n    color:var(--muted);\n    font-size:11px;\n    margin-top:6px;\n  }\n  .sub:first-child{ margin-top:0; }\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <h1>DX-Ball (1996) sound effect</h1>\n  <p class=\"lede\">Turn the sound on, watch the ball move from left to right, and switch between Original and Reversed to hear the beep move the other way.</p>\n\n  <div class=\"controls\">\n    <button id=\"sound\" type=\"button\" aria-pressed=\"false\">Sound: off</button>\n    <div class=\"segmented\" role=\"group\" aria-label=\"Module\">\n      <button id=\"mode-original\" type=\"button\" class=\"selected\" aria-pressed=\"true\">Original</button>\n      <button id=\"mode-reversed\" type=\"button\" aria-pressed=\"false\">Reversed</button>\n    </div>\n    <button id=\"pause\" type=\"button\" aria-pressed=\"false\">Pause</button>\n  </div>\n\n  <p class=\"hint\">Use headphones to hear left and right, since a phone's speakers barely separate them.</p>\n\n  <div class=\"stage\" id=\"stage\">\n    <div class=\"ticks\"><span>x = 0</span><span>320</span><span>640</span></div>\n    <div class=\"ball\" id=\"ball\"></div>\n    <div class=\"reading\" id=\"reading\">x = 0\nscreen_pan(x) = —</div>\n  </div>\n\n  <div class=\"meter\">\n    <div class=\"bar\"></div>\n    <div class=\"marker\" id=\"marker\"></div>\n  </div>\n  <div class=\"meter-labels\">\n    <span>left</span>\n    <span>stereo position sent to the speakers</span>\n    <span>right</span>\n  </div>\n\n  <details class=\"inspect\">\n    <summary>Inspect the two files this page loaded</summary>\n    <div class=\"inspect-body\">\n      <table>\n        <colgroup>\n          <col style=\"width:15%\"><col style=\"width:28%\"><col style=\"width:28%\"><col style=\"width:29%\">\n        </colgroup>\n        <thead>\n          <tr><th>Module</th><th>Model</th><th>Reply</th><th>SHA-256</th></tr>\n        </thead>\n        <tbody id=\"inspect-rows\">\n          <tr><td colspan=\"4\">Loading…</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </details>\n</div>\n\n<script src=\"modules.js\"></script>\n<script>\n(function(){\n  'use strict';\n\n  var $ = function(id){ return document.getElementById(id); };\n  var stage = $('stage'), ball = $('ball'), reading = $('reading'), marker = $('marker');\n  var soundBtn = $('sound'), pauseBtn = $('pause');\n  var origBtn = $('mode-original'), revBtn = $('mode-reversed');\n\n  var PAN = window.PAN_MODULES || null;\n\n  var modules = {};\n  var currentMode = 'original';\n  var soundOn = false;\n  var paused = false;\n  var audioCtx = null;\n  var beepTimer = null;\n\n  var TRAVERSE_MS = 6000;\n  var xFloat = 0;\n  var x = 0;\n  var lastTs = null;\n\n  function decodeBase64(b64){\n    var clean = String(b64 || '').replace(/\\s+/g, '');\n    var bin = atob(clean);\n    var bytes = new Uint8Array(bin.length);\n    for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n    return bytes;\n  }\n\n  function sha256Hex(bytes){\n    if (!(window.crypto && crypto.subtle && crypto.subtle.digest)) return Promise.resolve(null);\n    return crypto.subtle.digest('SHA-256', bytes).then(function(buf){\n      return Array.prototype.map.call(new Uint8Array(buf), function(b){\n        return b.toString(16).padStart(2, '0');\n      }).join('');\n    }).catch(function(){ return null; });\n  }\n\n  function screenPan(xx){\n    var m = modules[currentMode];\n    if (!m || !m.fn) return null;\n    try {\n      var v = m.fn(xx);\n      var n = Number(v);\n      return isNaN(n) ? null : n;\n    } catch (e) {\n      return null;\n    }\n  }\n\n  function updateReading(){\n    var W = stage.clientWidth;\n    var center = 16 + (W - 32) * (x / 640);\n    ball.style.left = center + 'px';\n\n    var v = screenPan(x);\n    var vText = (v === null) ? '—' : String(v);\n    reading.textContent = 'x = ' + x + '\\nscreen_pan(x) = ' + vText;\n\n    var half = (reading.offsetWidth || 190) / 2;\n    var minC = half + 4;\n    var maxC = W - half - 4;\n    var cx = center;\n    if (maxC < minC) cx = W / 2;\n    else cx = Math.min(maxC, Math.max(minC, cx));\n    reading.style.left = cx + 'px';\n\n    if (v === null) {\n      marker.style.opacity = '0';\n    } else {\n      marker.style.opacity = '1';\n      marker.style.left = (50 + 50 * v / 500) + '%';\n    }\n  }\n\n  function tick(ts){\n    if (lastTs === null) lastTs = ts;\n    var dt = Math.min(100, ts - lastTs);\n    lastTs = ts;\n    if (!paused) {\n      xFloat += dt * (640 / TRAVERSE_MS);\n      if (xFloat >= 640) xFloat -= 640;\n      x = Math.round(xFloat);\n    }\n    updateReading();\n    requestAnimationFrame(tick);\n  }\n\n  function playBeep(){\n    if (!soundOn || !audioCtx) return;\n    if (audioCtx.state === 'suspended') {\n      audioCtx.resume().catch(function(){});\n    }\n    var v = screenPan(x);\n    if (v === null) return;\n    var t = audioCtx.currentTime;\n    var osc = audioCtx.createOscillator();\n    var gain = audioCtx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(880, t);\n    gain.gain.setValueAtTime(0.0001, t);\n    gain.gain.linearRampToValueAtTime(0.22, t + 0.008);\n    gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.09);\n    osc.connect(gain);\n    if (typeof audioCtx.createStereoPanner === 'function') {\n      var pan = audioCtx.createStereoPanner();\n      pan.pan.setValueAtTime(Math.max(-1, Math.min(1, v / 500)), t);\n      gain.connect(pan);\n      pan.connect(audioCtx.destination);\n    } else {\n      gain.connect(audioCtx.destination);\n    }\n    osc.start(t);\n    osc.stop(t + 0.1);\n  }\n\n  function toggleSound(){\n    if (!soundOn) {\n      (async function(){\n        if (navigator.audioSession) {\n          try { navigator.audioSession.type = 'playback'; } catch (e) {}\n        }\n        try {\n          if (!audioCtx) {\n            var Ctor = window.AudioContext || window.webkitAudioContext;\n            if (Ctor) audioCtx = new Ctor();\n          }\n          if (audioCtx && audioCtx.state === 'suspended') await audioCtx.resume();\n        } catch (e) {}\n        soundOn = true;\n        soundBtn.textContent = 'Sound: on';\n        soundBtn.setAttribute('aria-pressed', 'true');\n        playBeep();\n        if (beepTimer) clearInterval(beepTimer);\n        beepTimer = setInterval(playBeep, 200);\n      })();\n    } else {\n      soundOn = false;\n      if (beepTimer) { clearInterval(beepTimer); beepTimer = null; }\n      soundBtn.textContent = 'Sound: off';\n      soundBtn.setAttribute('aria-pressed', 'false');\n    }\n  }\n\n  function setMode(mode){\n    currentMode = mode;\n    origBtn.classList.toggle('selected', mode === 'original');\n    revBtn.classList.toggle('selected', mode === 'reversed');\n    origBtn.setAttribute('aria-pressed', String(mode === 'original'));\n    revBtn.setAttribute('aria-pressed', String(mode === 'reversed'));\n    updateReading();\n  }\n\n  function buildInspect(){\n    var tbody = $('inspect-rows');\n    tbody.textContent = '';\n    if (!PAN) {\n      var tr = document.createElement('tr');\n      var td = document.createElement('td');\n      td.colSpan = 4;\n      td.textContent = 'modules.js was not found or window.PAN_MODULES is missing.';\n      tr.appendChild(td);\n      tbody.appendChild(tr);\n      return;\n    }\n    ['original', 'reversed'].forEach(function(key){\n      var entry = PAN[key];\n      var tr = document.createElement('tr');\n\n      var tdModule = document.createElement('td');\n      tdModule.textContent = entry ? (entry.label || key) : (key + ' (missing)');\n\n      var tdModel = document.createElement('td');\n      tdModel.textContent = entry ? (entry.model == null ? '' : entry.model) : '';\n\n      var tdReply = document.createElement('td');\n      tdReply.textContent = entry ? (entry.reply == null ? '' : entry.reply) : '';\n\n      var tdSha = document.createElement('td');\n\n      var recLabel = document.createElement('span');\n      recLabel.className = 'sub';\n      recLabel.textContent = 'recorded:';\n      var recCode = document.createElement('code');\n      recCode.textContent = entry ? (entry.sha256 == null ? '' : entry.sha256) : '';\n      tdSha.appendChild(recLabel);\n      tdSha.appendChild(recCode);\n\n      var loadLabel = document.createElement('span');\n      loadLabel.className = 'sub';\n      loadLabel.textContent = 'loaded:';\n      var loadCode = document.createElement('code');\n      loadCode.textContent = '…';\n      tdSha.appendChild(loadLabel);\n      tdSha.appendChild(loadCode);\n\n      var matchLabel = document.createElement('span');\n      matchLabel.className = 'sub';\n      matchLabel.textContent = 'match:';\n      var matchVal = document.createElement('span');\n      matchVal.textContent = '…';\n      tdSha.appendChild(matchLabel);\n      tdSha.appendChild(matchVal);\n\n      tr.appendChild(tdModule);\n      tr.appendChild(tdModel);\n      tr.appendChild(tdReply);\n      tr.appendChild(tdSha);\n      tbody.appendChild(tr);\n\n      var m = modules[key];\n      if (!m || !m.bytes) {\n        loadCode.textContent = 'unavailable';\n        matchVal.textContent = 'unavailable';\n        return;\n      }\n      sha256Hex(m.bytes).then(function(hex){\n        if (hex === null) {\n          loadCode.textContent = 'unavailable';\n          matchVal.textContent = 'unavailable';\n        } else {\n          loadCode.textContent = hex;\n          var rec = entry && entry.sha256 ? String(entry.sha256).trim().toLowerCase() : '';\n          matchVal.textContent = rec ? (hex.toLowerCase() === rec ? 'match' : 'mismatch') : 'no recorded value';\n        }\n      });\n    });\n  }\n\n  function load(){\n    if (!PAN) { buildInspect(); updateReading(); return; }\n    Promise.all(['original', 'reversed'].map(function(key){\n      var entry = PAN[key];\n      if (!entry) return Promise.resolve();\n      return (async function(){\n        try {\n          var bytes = decodeBase64(entry.bytes);\n          var mod = await WebAssembly.compile(bytes);\n          var instance = await WebAssembly.instantiate(mod, {});\n          var fn = instance.exports && instance.exports.screen_pan;\n          if (typeof fn !== 'function') throw new Error('module does not export screen_pan');\n          modules[key] = { entry: entry, bytes: bytes, fn: fn };\n        } catch (err) {\n          modules[key] = { entry: entry, bytes: null, fn: null, error: err };\n        }\n      })();\n    })).then(function(){\n      buildInspect();\n      updateReading();\n    });\n  }\n\n  soundBtn.addEventListener('click', toggleSound);\n  origBtn.addEventListener('click', function(){ setMode('original'); });\n  revBtn.addEventListener('click', function(){ setMode('reversed'); });\n  pauseBtn.addEventListener('click', function(){\n    paused = !paused;\n    pauseBtn.textContent = paused ? 'Play' : 'Pause';\n    pauseBtn.setAttribute('aria-pressed', String(paused));\n  });\n\n  load();\n  requestAnimationFrame(tick);\n})();\n</script>\n</body>\n</html>",
