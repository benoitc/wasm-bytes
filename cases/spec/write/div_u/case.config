%% A writing case from the spec tests. The calls and results are the upstream assertions for this instruction; the description is this project's.
{export, <<"f">>}.
{params, [i32, i32]}.
{results, [i32]}.
{description, <<"It divides its first argument by its second, both read as unsigned 32-bit integers, and returns the quotient.">>}.
{calls, [
    {[1, 1], 1},
    {[0, 1], 0},
    {[-1, -1], 1},
    {[-2147483648, -1], 0},
    {[-2147483648, 2], 1073741824},
    {[-1880092688, 65537], 36847},
    {[-2147483647, 1000], 2147483},
    {[5, 2], 2},
    {[-5, 2], 2147483645},
    {[5, -2], 0},
    {[-5, -2], 0},
    {[7, 3], 2},
    {[11, 5], 2},
    {[17, 7], 2}]}.
{upstream, [
    {repo, <<"https://github.com/WebAssembly/testsuite">>},
    {commit, <<"92a3d806c7d70f5b63f125e6155b8d76304509f1">>},
    {file, <<"i32.wast">>},
    {lines, [87, 88, 89, 90, 91, 92, 93, 94, 95, 96, 97, 98, 99, 100]},
    {instruction, <<"i32.div_u">>}]}.
