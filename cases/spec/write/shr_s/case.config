%% A writing case from the spec tests. The calls and results are the upstream assertions for this instruction; the description is this project's.
{export, <<"f">>}.
{params, [i32, i32]}.
{results, [i32]}.
{description, <<"It shifts its first argument right by its second argument taken modulo 32, copying the sign bit into the bits it vacates.">>}.
{calls, [
    {[1, 1], 0},
    {[1, 0], 1},
    {[-1, 1], -1},
    {[2147483647, 1], 1073741823},
    {[-2147483648, 1], -1073741824},
    {[1073741824, 1], 536870912},
    {[1, 32], 1},
    {[1, 33], 0},
    {[1, -1], 0},
    {[1, 2147483647], 0},
    {[1, -2147483648], 1},
    {[-2147483648, 31], -1},
    {[-1, 32], -1},
    {[-1, 33], -1},
    {[-1, -1], -1},
    {[-1, 2147483647], -1},
    {[-1, -2147483648], -1}]}.
{upstream, [
    {repo, <<"https://github.com/WebAssembly/testsuite">>},
    {commit, <<"92a3d806c7d70f5b63f125e6155b8d76304509f1">>},
    {file, <<"i32.wast">>},
    {lines, [181, 182, 183, 184, 185, 186, 187, 188, 189, 190, 191, 192, 193, 194, 195, 196, 197]},
    {instruction, <<"i32.shr_s">>}]}.
