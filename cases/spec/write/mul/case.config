%% A writing case from the spec tests. The calls and results are the upstream assertions for this instruction; the description is this project's.
{export, <<"f">>}.
{params, [i32, i32]}.
{results, [i32]}.
{description, <<"It multiplies its two arguments and returns the low 32 bits of the product.">>}.
{calls, [
    {[1, 1], 1},
    {[1, 0], 0},
    {[-1, -1], 1},
    {[268435456, 4096], 0},
    {[-2147483648, 0], 0},
    {[-2147483648, -1], -2147483648},
    {[2147483647, -1], -2147483647},
    {[19088743, 1985229328], 898528368},
    {[2147483647, 2147483647], 1}]}.
{upstream, [
    {repo, <<"https://github.com/WebAssembly/testsuite">>},
    {commit, <<"92a3d806c7d70f5b63f125e6155b8d76304509f1">>},
    {file, <<"i32.wast">>},
    {lines, [54, 55, 56, 57, 58, 59, 60, 61, 62]},
    {instruction, <<"i32.mul">>}]}.
