%% A writing case from the spec tests. The calls and results are the upstream assertions for this instruction; the description is this project's.
{export, <<"f">>}.
{params, [i32, i32]}.
{results, [i32]}.
{description, <<"It subtracts its second argument from its first, wrapping on 32-bit overflow.">>}.
{calls, [
    {[1, 1], 0},
    {[1, 0], 1},
    {[-1, -1], 0},
    {[2147483647, -1], -2147483648},
    {[-2147483648, 1], 2147483647},
    {[-2147483648, -2147483648], 0},
    {[1073741823, -1], 1073741824}]}.
{upstream, [
    {repo, <<"https://github.com/WebAssembly/testsuite">>},
    {commit, <<"92a3d806c7d70f5b63f125e6155b8d76304509f1">>},
    {file, <<"i32.wast">>},
    {lines, [46, 47, 48, 49, 50, 51, 52]},
    {instruction, <<"i32.sub">>}]}.
