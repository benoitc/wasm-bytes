%% -*- erlang -*-
{erl_opts, [debug_info, warnings_as_errors]}.

%% erlang_wasm, pinned to a release published on Hex. The OTP application is
%% `wasm'; the Hex package is `erlang_wasm'. rebar.lock records the exact
%% version and checksum.
{deps, [
    {wasm, "0.11.0", {pkg, erlang_wasm}}
]}.

{xref_checks, [undefined_function_calls, locals_not_used]}.
